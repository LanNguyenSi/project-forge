# GitHub Personal Access Token (repo, workflow scopes)
GITHUB_TOKEN=ghp_your_token_here

# GitHub owner for new repos
GITHUB_OWNER=YourUsername

# Path to agent-planforge directory
PLANFORGE_PATH=/path/to/agent-planforge

# Path to scaffoldkit venv python
SCAFFOLDKIT_PYTHON=/path/to/.venv/bin/python3

# Temp directory base (defaults to /tmp)
FORGE_TEMP_DIR=/tmp
